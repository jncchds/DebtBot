{
  "name": "debtbot-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:i18n && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
