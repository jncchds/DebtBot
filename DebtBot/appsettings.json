{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DebtBot": "Server=db;Port=5432;Database=debtBot;User Id=postgres;Password=postgres;"
  },
  "DebtBot": {
    "Migration": {
      "RetryCount": 3,
      "RetryDelay": 3000
    },
    "LedgerProcessor": {
      "RetryCount": 3,
      "RetryDelay": 3000,
      "ProcessorDelay": 2000
    },
    "BillProcessor": {
      "RetryCount": 3,
      "RetryDelay": 3000,
      "ProcessorDelay": 2000
    },
    "JwtConfiguration": {
      "Issuer": "DebtBot",
      "Audience": "DebtBot",
      "Key": "DebtBotSecretKeyDebtBotSecretKeyDebtBotSecretKeyDebtBotSecretKey",
      "LifeTime": 60,
      "RefreshTokenLifetimeDays": 30
    },
    "RabbitMq": {
      "Host": "rabbit",
      "Username": "debtbot",
      "Password": "debtbot"
    },
    "Telegram": {
      "BotToken": "YOUR:TOKEN:HERE",
      "CountPerPage": 6,
      "LogBotToken": "YOUR:LOG:TOKEN:HERE:IF:NEEDED", // Empty if you don't want to log to telegram
      "LogChatId": 0, // 0 If you don't want to log to telegram
      "LogLevel": {
        "Default": "Error"
      }
    },
    "Llm": {
      "Provider": "OpenRouter", // or "Fake" (fixtures instead of a model, Development only)
      "BaseUrl": "https://openrouter.ai/api/v1",
      "Model": "nvidia/nemotron-3.5-super-vl:free", // free models checked 2026-11-27: see LlmConfiguration
      "FallbackModels": "google/gemma-4-31b-it:free", // comma-separated
      "ApiKey": "", // secret: set DebtBot_DebtBot__Llm__ApiKey; empty turns receipt reading off
      "ResponseFormat": "json_schema", // or "json_object" for APIs without structured output
      "TimeoutSeconds": 45,
      "UserHourlyLimit": 10,
      "UserDailyLimit": 30
    }
  }
}
